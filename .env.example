# --- Администратор сайта (страница /admin) ---
ADMIN_USERNAME=iren
# Хеш пароля: python3 -m server.hash_password 'Пароль'  (см. deploy/DEPLOY.md §3)
ADMIN_PASSWORD_HASH=
# Ключ подписи сессионных cookie: openssl rand -hex 32
SESSION_SECRET=

# --- Прочее ---
COOKIE_SECURE=true             # true за HTTPS (на сервере), false — только для локальной отладки
DATABASE_PATH=data/site.db
