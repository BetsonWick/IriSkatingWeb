# --- Уведомления о заявках в Telegram ---
# Тот же бот, что и iriskating-bot: токен и chat_id владельца
# (из ADMIN_TELEGRAM_IDS в .env бота). Несколько получателей — через запятую.
# Пусто — заявки сохраняются без уведомления.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# --- Администратор сайта (страница /admin) ---
ADMIN_USERNAME=iren
# Хеш пароля: python3 -m server.hash_password 'Пароль'  (см. deploy/DEPLOY.md §3)
ADMIN_PASSWORD_HASH=
# Ключ подписи сессионных cookie: openssl rand -hex 32
SESSION_SECRET=

# --- Прочее ---
COOKIE_SECURE=true             # true за HTTPS (на сервере), false — только для локальной отладки
DATABASE_PATH=data/site.db
